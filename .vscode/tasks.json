{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "simulate",
      "type": "shell",
      "command": "./sim.sh ${relativeFileDirname} ${input:top}",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "top",
      "type": "promptString",
      "description": "Top-level testbench module",
      "default": "tb_alu"
    }
  ]
}